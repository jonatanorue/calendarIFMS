# Client ID OAuth do tipo "Aplicativo da Web" criado no Google Cloud Console.
# Origens JavaScript autorizadas: http://localhost:3001 e http://localhost
GOOGLE_CLIENT_ID=

# Primeiro administrador. É cadastrado ao iniciar o servidor se ainda não existir no banco.
ADMIN_EMAIL=

# Porta do servidor (padrão 3001).
# PORT=3001

# Caminho do banco SQLite (padrão data/calendar.db).
# DATABASE_PATH=data/calendar.db

# Envia o cookie de sessão só por HTTPS. Use 1 em produção.
# COOKIE_SECURE=1

# Habilita login digitando o e-mail, sem Google. Somente para desenvolvimento local.
# DEV_LOGIN=1
