# Client ID OAuth do tipo "Aplicativo da Web" criado no Google Cloud Console.
# Origens JavaScript autorizadas: http://localhost:3001 e http://localhost (e a URL de produção).
GOOGLE_CLIENT_ID=

# Domínio Google Workspace exigido no login (claim "hd" do token). Padrão: ifms.edu.br.
# Deixe vazio (GOOGLE_HOSTED_DOMAIN=) apenas se as contas do IFMS não forem Google Workspace.
# GOOGLE_HOSTED_DOMAIN=ifms.edu.br

# Primeiro administrador. É cadastrado ao iniciar o servidor apenas enquanto o banco
# não tiver nenhum administrador.
ADMIN_EMAIL=

# Porta do servidor (padrão 3001).
# PORT=3001

# Caminho do banco SQLite (padrão data/calendar.db).
# DATABASE_PATH=data/calendar.db

# Envia o cookie de sessão só por HTTPS e ativa HSTS. Use 1 em produção.
# COOKIE_SECURE=1

# Use 1 atrás de proxy reverso, para o limite de tentativas de login usar o IP real.
# TRUST_PROXY=1

# Docker: interface e porta publicadas no servidor (padrão 127.0.0.1:3001).
# HOST_BIND=127.0.0.1
# HOST_PORT=3001

# Habilita login digitando o e-mail, sem Google. Somente para desenvolvimento local;
# é recusado quando NODE_ENV=production (como no container Docker).
# DEV_LOGIN=1
